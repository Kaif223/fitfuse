{
  "expo": {
    "name": "FitFuse",
    "slug": "fitfuse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitfuse",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/fitfuse_logo.jpeg",
    "splash": {
      "image": "./assets/fitfuse_logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitfuse.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fitfuse_logo.jpeg",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.fitfuse.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitFuse to access your camera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitFuse to access your photos."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c188b6d0-a8df-412f-a470-7e89f63000ce"
      }
    },
    "owner": "zulqaif223s-organization"
  }
}
